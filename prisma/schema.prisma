generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  memberships  Membership[]
  projectSeats ProjectMember[]
  assignedTasks Task[]              @relation("TaskAssignee")
  uploads      DeliverableVersion[] @relation("VersionUploader")
  comments     Comment[]            @relation("CommentAuthor")
  activities   ActivityLog[]        @relation("ActivityActor")
  notifications Notification[]
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  plan          String             @default("FREE")
  invoiceSeq    Int                @default(1000)
  brandColor    String?
  createdAt     DateTime           @default(now())
  memberships   Membership[]
  clients       Client[]
  projects      Project[]
  tasks         Task[]
  deliverables  Deliverable[]
  versions      DeliverableVersion[]
  comments      Comment[]
  invoices      Invoice[]
  activities    ActivityLog[]
  notifications Notification[]
  messages      OutboundMessage[]
  jobRuns       JobRun[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  clientId       String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  company        String
  contactName    String
  email          String
  phone          String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  invoices       Invoice[]
  memberships    Membership[]

  @@unique([organizationId, email])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String          @default("")
  status         String          @default("PLANNING")
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  milestones     Milestone[]
  tasks          Task[]
  deliverables   Deliverable[]
  invoices       Invoice[]

  @@index([organizationId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  status    String    @default("OPEN")
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  milestoneId    String?
  title          String
  status         String        @default("TODO")
  assigneeId     String?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Deliverable {
  id             String               @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       DeliverableVersion[]
}

model DeliverableVersion {
  id                String       @id @default(cuid())
  organizationId    String
  deliverableId     String
  version           Int
  fileName          String
  storageKey        String
  contentType       String
  byteSize          Int
  changeDescription String       @default("")
  status            String       @default("PENDING")
  uploadedById      String
  uploadedAt        DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliverable       Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedBy        User         @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  comments          Comment[]

  @@unique([deliverableId, version])
}

model Comment {
  id             String             @id @default(cuid())
  organizationId String
  versionId      String
  authorId       String
  body           String
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        DeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author         User               @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  clientId       String
  number         String
  status         String        @default("DRAFT")
  subtotal       Int
  taxRate        Int
  tax            Int
  total          Int
  dueDate        DateTime
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]

  @@unique([organizationId, number])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  amount      Int
  position    Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  resource       String
  resourceId     String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, read])
}

model OutboundMessage {
  id             String       @id @default(cuid())
  organizationId String
  toEmail        String
  subject        String
  body           String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model JobRun {
  id             String       @id @default(cuid())
  organizationId String
  result         String
  ranAt          DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
