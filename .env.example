DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE"
SESSION_SECRET="dev-only-session-secret-change-me"
CRON_SECRET="dev-only-cron-secret-change-me"
# Optional. When all four are set, uploads go to S3-compatible storage instead of the local storage/ folder.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"
